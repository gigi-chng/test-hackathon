generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

model PartnerContent {
  id          String    @id @default(cuid())
  partner     String // "sam" | "will" | "yoni" | "megan"
  sourceType  String // "tweet" | "blog" | "newsletter" | "podcast" | "press"
  sourceUrl   String?
  title       String?
  content     String
  embedding   Float[]
  tags        String[]  @default([])
  manual      Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([sourceUrl])
  @@index([partner, sourceType, publishedAt])
  @@index([createdAt])
  @@map("partner_content")
}

model PartnerProfile {
  id          String    @id @default(cuid())
  partner     String    @unique
  toneOfVoice String    @default("")
  pointOfView String    @default("")
  themes      String[]
  styleNotes  String    @default("")
  rawProfile  String    @default("") // full JSON for agent use
  generatedAt DateTime?
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  @@map("partner_profiles")
}

model Transcript {
  id           String   @id @default(cuid())
  title        String
  source       String   @default("internal") // "more-or-less" | "partner-meeting" | "internal" | "other"
  recordedAt   DateTime?
  participants String[] // raw speaker labels found in the file
  // partner key -> speaker label, as confirmed by a human. Auto-matching alone
  // is unsafe: one episode had two Sams and two Scotts.
  speakerMap   Json?
  rawText      String
  segmentCount Int      @default(0)
  createdAt    DateTime @default(now())

  // Riverside sync. "confirmed" is the default so the rows that predate the
  // sync don't suddenly show up in the review queue.
  status        String  @default("confirmed") // "pending" | "confirmed"
  riversideId   String? @unique // recording_id, so a re-run doesn't duplicate
  sourceProject String? // Riverside project/studio name the recording came from
  // Unnamed speakers get their own audio track in Riverside, so we keep
  // { speakerLabel: fileId } and can stream just that person to identify them.
  speakerMedia  Json?
  // Stamped once the "who is this?" email goes out, so the daily cron doesn't
  // re-send the same request every morning.
  speakerAlertAt DateTime?
  // One-click speaker identification from that email. The token is the
  // credential, same as MediaAppearance.verifyToken. Optional because rows
  // already existed when this was added.
  identifyToken   String? @unique @default(cuid())
  // { speakerLabel: partnerKey | "none" } — accumulated one tap at a time,
  // since a recording usually needs more than one answer.
  identifyChoices Json?

  @@index([recordedAt])
  @@index([status])
  @@map("transcripts")
}

// Remembered speaker label -> partner decisions, so the review queue asks about
// each new name once instead of every episode. partner: null means "confirmed
// not a partner" (a guest), which is just as useful to remember.
model SpeakerAlias {
  id        String   @id @default(cuid())
  label     String   @unique // lowercased raw label
  display   String // the label as it actually appeared
  partner   String?
  createdAt DateTime @default(now())

  @@map("speaker_aliases")
}

model VideoLibrary {
  id         String   @id @default(cuid())
  partner    String
  title      String
  storageUrl String
  transcript String?
  topics     String[]
  embedding  Float[]
  duration   Int?
  forcedNext Boolean  @default(false)
  uploadedAt DateTime @default(now())

  @@map("video_library")
}

model TrendSignal {
  id             String   @id @default(cuid())
  headline       String
  summary        String
  source         String
  sourceUrl      String?
  relevanceScore Float
  status         String   @default("pending") // pending | drafted | skipped
  detectedAt     DateTime @default(now())

  @@map("trend_signals")
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

model MediaAppearance {
  id              String    @id @default(cuid())
  partner         String // "sam" | "will" | "yoni" | "megan"
  type            String // "podcast" | "press" | "panel" | "newsletter" | "video" | "other"
  show            String
  title           String
  url             String
  publishedAt     DateTime?
  transcript      String?
  topics          String[]
  notes           String?
  status          String    @default("ready") // "processing" | "ready" | "error"
  processingJobId String?
  createdAt       DateTime  @default(now())

  // Only true when someone has actually read the source and confirmed a
  // partner or Slow Ventures is named in it. A search-engine summary saying
  // so is not confirmation — Forbes turned out to name "Yoav Rechtman" and
  // never mention the firm.
  verified        Boolean   @default(false)
  verifiedNote    String?
  // Confirm/reject straight from the weekly email, same one-click token
  // pattern as post draft approvals. Rejected rows stay for the audit trail
  // but drop out of the reminder.
  // Optional because the table already had rows when this was added; the
  // existing ones are backfilled by the admin migrate route.
  verifyToken     String?   @unique @default(cuid())
  rejectedAt      DateTime?

  @@map("media_appearances")
}

model TrackerProject {
  id          String   @id @default(cuid())
  vertical    String // "slow" | "slow-creator" | "sam"
  name        String
  description String?
  status      String   @default("active") // active | paused | completed
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  kpis        TrackerKPI[]
  weeklyGoals TrackerGoal[]
  updates     TrackerUpdate[]

  @@map("tracker_projects")
}

model TrackerKPI {
  id        String         @id @default(cuid())
  projectId String
  name      String
  unit      String?
  target    Float?
  current   Float?
  stage     String         @default("live") // "pre-live" | "live"
  updatedAt DateTime       @updatedAt
  project   TrackerProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("tracker_kpis")
}

model TrackerGoal {
  id          String         @id @default(cuid())
  projectId   String
  weekOf      DateTime // Monday of the week
  text        String
  type        String         @default("deliverable") // "deliverable" | "metric"
  workType    String         @default("sprint") // "sprint" | "maintenance"
  priority    String         @default("p2") // "p1" | "p2" | "p3"
  rankOrder   Int            @default(0)
  targetValue Float?
  actualValue Float?
  completed   Boolean        @default(false)
  notes       String?
  createdAt   DateTime       @default(now())
  project     TrackerProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("tracker_goals")
}

model TrackerUpdate {
  id        String         @id @default(cuid())
  projectId String
  text      String
  createdAt DateTime       @default(now())
  project   TrackerProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("tracker_updates")
}

model PostDraft {
  id               String    @id @default(cuid())
  trendSignalId    String?
  partner          String
  partnerCitation  String
  hook             String
  body             String
  platform         String    @default("both") // twitter | linkedin | both
  videoId          String?
  quoteTweetId     String?
  quoteTweetUrl    String?
  partnerSourceUrl String?
  status           String    @default("pending") // pending | approved | rejected | published
  approvalToken    String    @unique @default(cuid())
  feedback         String?
  source           String    @default("agent") // "agent" | "announcement"
  scheduledAt      DateTime?
  publishedAt      DateTime?
  createdAt        DateTime  @default(now())

  @@map("post_drafts")
}
